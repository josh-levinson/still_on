<% content_for :title, "#{@event.title} – RSVP" %>
<% content_for :hide_nav_cta, true %>
<% organizer = @event.created_by.first_name.presence || "Your organizer" %>
<% starts = @event_occurrence.start_time %>

<div class="rsvp-page">
  <div class="rsvp-shell">

    <%# ── The ask, as a text from the organizer ── %>
    <div class="rsvp-ask">
      <div class="rsvp-ask-row">
        <span class="rsvp-avatar" aria-hidden="true"><%= organizer.first %></span>
        <div class="rsvp-bubble">
          <p><%= @event.title %> <%= starts.strftime("%A") %>, still on?</p>
          <% if @event.description.present? %>
            <p><%= @event.description %></p>
          <% end %>
        </div>
      </div>
      <p class="rsvp-ask-from"><%= organizer %> · organizer</p>
    </div>

    <%# ── Event details ── %>
    <div class="rsvp-event-card">
      <div class="rsvp-date-tile" aria-hidden="true">
        <span class="rsvp-date-tile-day"><%= starts.strftime("%a").upcase %></span>
        <span class="rsvp-date-tile-num"><%= starts.day %></span>
        <span class="rsvp-date-tile-month"><%= starts.strftime("%b") %></span>
      </div>
      <div class="rsvp-event-info">
        <% if @group.name != @event.title %>
          <p class="rsvp-group-name"><%= @group.name %></p>
        <% end %>
        <h1 class="rsvp-event-title"><%= @event.title %></h1>
        <p class="rsvp-event-meta">
          <span class="rsvp-date"><%= starts.strftime("%A, %B %-d") %></span><br>
          <span class="rsvp-time">
            <%= starts.strftime("%-l:%M %p") %> &ndash;
            <%= @event_occurrence.end_time.strftime("%-l:%M %p") %>
            <%= starts.zone %>
          </span>
        </p>
        <% if @event_occurrence.location.present? %>
          <p class="rsvp-location"><%= @event_occurrence.location %></p>
        <% end %>
      </div>
    </div>

    <%# ── Who's in ── %>
    <% going = @event_occurrence.attending_rsvps.to_a %>
    <div class="rsvp-going">
      <p class="rsvp-going-heading">
        <% if going.any? %>
          <%= @event_occurrence.attending_count %> in so far
        <% else %>
          No one's in yet
        <% end %>
      </p>
      <ul class="rsvp-going-list">
        <% going.each do |rsvp| %>
          <li class="rsvp-going-name"><%= rsvp.short_name %><%= " +#{rsvp.guest_count}" if rsvp.guest_count.positive? %></li>
        <% end %>
        <% unless @existing_rsvp&.status == "attending" %>
          <li class="rsvp-going-name rsvp-going-you">you?</li>
        <% end %>
      </ul>
    </div>

    <%# ── Capacity warning ── %>
    <% if @event_occurrence.full? %>
      <div class="rsvp-capacity-warning">This event is full.</div>
    <% elsif @event_occurrence.max_attendees.present? %>
      <% spots_left = @event_occurrence.max_attendees - @event_occurrence.attending_count %>
      <% if spots_left <= 3 %>
        <div class="rsvp-capacity-warning"><%= spots_left %> <%= "spot".pluralize(spots_left) %> left!</div>
      <% end %>
    <% end %>

    <%# ── Flash messages ── %>
    <% if notice.present? %>
      <div class="rsvp-notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="rsvp-error"><%= alert %></div>
    <% end %>

    <%# ── Existing RSVP confirmation ── %>
    <% if @existing_rsvp %>
      <div class="rsvp-confirmed">
        <div class="rsvp-confirmed-status rsvp-confirmed-<%= @existing_rsvp.status %>">
          <% case @existing_rsvp.status
             when "attending" %><span class="rsvp-confirmed-icon">&#10003;</span> You're in!
          <% when "maybe" %><span class="rsvp-confirmed-icon">&#8764;</span> You're a maybe
          <% when "declined" %><span class="rsvp-confirmed-icon">&times;</span> You declined
          <% end %>
        </div>
        <p class="rsvp-confirmed-sub">Change your mind?</p>
      </div>
    <% end %>

    <%# ── Add to calendar (attending/maybe only) ── %>
    <% if @existing_rsvp&.status.in?(%w[attending maybe]) %>
      <div class="rsvp-add-to-calendar">
        <%= link_to "Add to Google Calendar",
              google_calendar_url(@event_occurrence, @event),
              target: "_blank", rel: "noopener noreferrer",
              class: "rsvp-calendar-btn" %>
        <%= link_to "Download .ics",
              guest_rsvp_calendar_path(@token),
              class: "rsvp-calendar-btn rsvp-calendar-btn--secondary" %>
      </div>
    <% end %>

    <%# ── RSVP form ── %>
    <%= form_with url: guest_rsvp_path(@token), method: :post, local: true, class: "rsvp-form" do |f| %>
      <% if @rsvp.errors.any? %>
        <div class="rsvp-error">
          <%= @rsvp.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%# Name — required for guests, hidden for signed-in users %>
      <% unless current_user %>
        <div class="rsvp-field">
          <label class="rsvp-label" for="rsvp_guest_name">Your name</label>
          <%= f.text_field :guest_name,
                value: @rsvp.guest_name || @prefilled_name,
                placeholder: "First name",
                autocomplete: "given-name",
                class: "rsvp-input",
                required: true %>
        </div>
      <% end %>

      <%# RSVP status — big tap targets %>
      <fieldset class="rsvp-status-group">
        <legend class="rsvp-label">You in?</legend>
        <div class="rsvp-status-options">
          <% [["attending", "I'm in"], ["maybe", "Maybe"], ["declined", "Can't"]].each do |value, label| %>
            <label class="rsvp-status-option rsvp-status-<%= value %>">
              <%= f.radio_button :status, value, checked: @rsvp.status == value, class: "rsvp-status-radio" %>
              <span class="rsvp-status-label"><%= label %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <%# Guest count %>
      <div class="rsvp-field rsvp-field-inline">
        <label class="rsvp-label" for="rsvp_guest_count">Bringing anyone?</label>
        <div class="rsvp-stepper" data-controller="stepper">
          <button type="button" class="rsvp-stepper-btn" aria-label="One fewer guest" data-action="click->stepper#decrement">−</button>
          <%= f.number_field :guest_count,
                value: @rsvp.guest_count || 0,
                min: 0, max: 20,
                class: "rsvp-stepper-input",
                data: { stepper_target: "value" } %>
          <button type="button" class="rsvp-stepper-btn" aria-label="One more guest" data-action="click->stepper#increment">+</button>
        </div>
      </div>

      <% unless current_user %>
        <% if @prefilled_phone.present? %>
          <%= f.hidden_field :guest_phone, value: @prefilled_phone %>
          <div class="rsvp-field rsvp-future-reminders">
            <label class="rsvp-checkbox-label">
              <%= check_box_tag :send_future_reminders, "1",
                    GuestGroupSubscription.subscribed?(group: @group, phone_number: @prefilled_phone),
                    class: "rsvp-checkbox" %>
              Text me a reminder to RSVP for future <%= @group.name %> events
            </label>
            <p class="rsvp-sms-consent">Up to one text per hangout. Msg &amp; data rates may apply. Reply HELP for help, STOP to opt out. <%= link_to "Terms", terms_path %> &middot; <%= link_to "Privacy", privacy_path %>.</p>
          </div>
        <% else %>
          <div class="rsvp-field rsvp-phone-opt-in">
            <label class="rsvp-label" for="rsvp_guest_phone">
              Text me the day of
              <span class="rsvp-optional">(optional)</span>
            </label>
            <%= f.telephone_field :guest_phone,
                  value: @rsvp.guest_phone || @cookie_phone,
                  placeholder: "(555) 000-0000",
                  inputmode: "tel",
                  autocomplete: "tel-national",
                  class: "rsvp-input" %>
            <p class="rsvp-sms-consent">We'll send you one SMS the morning of the event. Msg &amp; data rates may apply. Reply HELP for help, STOP to opt out. <%= link_to "Terms", terms_path %> &middot; <%= link_to "Privacy", privacy_path %>.</p>
          </div>
          <% existing_phone = @rsvp.guest_phone || @cookie_phone %>
          <div class="rsvp-field rsvp-future-reminders">
            <label class="rsvp-checkbox-label">
              <%= check_box_tag :send_future_reminders, "1",
                    GuestGroupSubscription.subscribed?(group: @group, phone_number: existing_phone),
                    class: "rsvp-checkbox" %>
              Text me a reminder to RSVP for future <%= @group.name %> events
            </label>
          </div>
        <% end %>
      <% end %>

      <%# Email — optional, for notification fallback when SMS is unavailable %>
      <% unless current_user %>
        <div class="rsvp-field rsvp-email-opt-in">
          <label class="rsvp-label" for="rsvp_email">
            Email
            <span class="rsvp-optional">(optional)</span>
          </label>
          <%= f.email_field :email,
                value: @rsvp.email,
                placeholder: "you@example.com",
                autocomplete: "email",
                class: "rsvp-input" %>
          <p class="rsvp-sms-consent">Only used if we can't reach you by text.</p>
        </div>
      <% end %>

      <%= f.submit(@existing_rsvp ? "Update RSVP" : "Send it", class: "rsvp-submit-btn") %>
    <% end %>

    <%# ── Account claim nudge (shown after RSVP, guests only) ── %>
    <% if @existing_rsvp && !current_user %>
      <div class="rsvp-claim-nudge">
        <h2 class="rsvp-claim-nudge-heading">Want to keep track of your RSVPs?</h2>
        <p class="rsvp-claim-nudge-copy">Create a free account with your phone number and we'll save your RSVPs in one place.</p>
        <%= link_to "Create a free account", new_account_claim_path, class: "rsvp-claim-nudge-btn" %>
      </div>
    <% end %>

    <%# ── Resend link ── %>
    <p class="rsvp-resend-prompt">
      Lost your link? <%= link_to "Text it to me again", new_guest_rsvp_resend_path, class: "rsvp-resend-link" %>
    </p>

  </div>
</div>
